# Copy to .env and adjust. Never commit .env.
# Local Ollama server (default) and chat model used for answering / agent reasoning.
LEX6_OLLAMA_BASE_URL=http://localhost:11434
LEX6_LLM_MODEL=deepseek-r1:8b
# Answer length is uncapped (-1). Prompt + answer (+ deepseek-r1 reasoning) share the context window; raise
# LEX6_LLM_NUM_CTX if answers get cut off (the server logs a warning) and your RAM/VRAM allows.
LEX6_LLM_NUM_PREDICT=-1
LEX6_LLM_NUM_CTX=16384
# Extra tokens for short capped calls (routing, planning, translation) on reasoning models such as deepseek-r1,
# whose hidden <think> reasoning counts toward the cap.
LEX6_LLM_REASONING_BUDGET=4096
# Model used to translate non-English documents into English during ingestion.
LEX6_TRANSLATION_MODEL=deepseek-r1:8b
# HyDE generator. "*-cloud" models need OLLAMA_API_KEY; without it the local LLM is used.
LEX6_HYDE_MODEL=gpt-oss:120b-cloud
LEX6_OLLAMA_CLOUD_HOST=https://ollama.com
# OLLAMA_API_KEY=
# Embedding + reranking models (HuggingFace).
LEX6_EMBEDDING_MODEL=BAAI/bge-m3
LEX6_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Storage. Relative paths resolve against the project folder (or LEX6_HOME), not the directory lex6 is started from.
LEX6_DATA_DIR=data
# Folder indexed on `lex6 serve` startup (recursively). Unset = the whole data dir (minus vector_store/ and uploads/).
# LEX6_CORPUS_DIR=data

# Web UI/API passcode login: SHA-256 of the passcode (default is the hash of the project passcode).
# python -c "import hashlib; print(hashlib.sha256(b'NEW').hexdigest())"   (empty = no login)
# LEX6_ACCESS_PASSCODE_SHA256=
# Signs login cookies; set it to keep users logged in across server restarts.
# LEX6_SESSION_SECRET=
